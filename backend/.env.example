# Copy to backend/.env; this file is an example, never put real keys in Git.
# The backend now loads .env automatically on startup.
COMPANION_ENABLE_LLM=false
LLM_PROVIDER=template
# To enable conversational AI, set COMPANION_ENABLE_LLM=true,
# select gemini, openai or anthropic, and provide its key below.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=choose-a-supported-model
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PREDICTION_HISTORY_SEASONS=10
PREDICTION_TEST_SEASONS=3
