# Choose template (no API calls), gemini, or openai.
LLM_PROVIDER=template
# Optional Gemini settings. Enter the key only in your ignored local .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional OpenAI settings; used only when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Comma-separated browser origins allowed to call the backend.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Forecast history includes the current season; evaluation uses prior full seasons.
PREDICTION_HISTORY_SEASONS=10
PREDICTION_TEST_SEASONS=3
